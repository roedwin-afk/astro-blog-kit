---
import type { BlogListProps } from "../../types";
import type { BlogPost } from "../../types";
import { getFeaturedImageUrl } from "../../utils/slug";

interface Props extends BlogListProps {}

const { posts, blogBase, dateLocale, t } = Astro.props;
---

<div class="bk-cards">
  {posts.map((post: BlogPost) => {
    const imgUrl = getFeaturedImageUrl(post);
    return (
      <article class="bk-card">
        <a href={`${blogBase}${post.slug}/`} class="bk-card__link">
          <div
            class="bk-card__bg"
            style={imgUrl ? `background-image: url('${imgUrl}')` : ""}
          >
            {!imgUrl && (
              <div class="bk-card__no-image">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="M21 15l-5-5L5 21"/>
                </svg>
              </div>
            )}
            <div class="bk-card__overlay" />
            <div class="bk-card__content">
              <time class="bk-card__date">
                {new Date(post.date).toLocaleDateString(dateLocale, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <h2 class="bk-card__title" set:html={post.title.rendered} />
              <div class="bk-card__excerpt" set:html={post.excerpt.rendered} />
              <span class="bk-card__cta">{t.blog.btncta} →</span>
            </div>
          </div>
        </a>
      </article>
    );
  })}
</div>

<style>
  .bk-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .bk-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .bk-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bk-card {
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .bk-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .bk-card__link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .bk-card__bg {
    position: relative;
    height: 380px;
    background-color: var(--bk-surface);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .bk-card__no-image {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bk-color-muted);
  }

  .bk-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.3) 40%,
      rgba(0, 0, 0, 0.85) 100%
    );
    border-radius: 12px;
  }

  .bk-card__content {
    position: relative;
    z-index: 1;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .bk-card__date {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--bk-font-mono);
  }

  .bk-card__title {
    font-family: var(--bk-font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin: 0;
  }

  .bk-card__excerpt {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bk-card__excerpt :global(p) {
    margin: 0;
  }

  .bk-card__cta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bk-color-accent);
    display: inline-block;
    margin-top: 0.5rem;
    transition: transform 0.2s ease;
  }

  .bk-card:hover .bk-card__cta {
    transform: translateX(4px);
  }
</style>