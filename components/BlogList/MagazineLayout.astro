---
import type { BlogListProps } from "../../types";
import type { BlogPost } from "../../types";
import BlogCard from "../BlogCard.astro";

interface Props extends BlogListProps {}

const { posts, blogBase, dateLocale, t } = Astro.props;

const featured = posts[0] as BlogPost | undefined;
const rest = posts.slice(1) as BlogPost[];
---

<div class="bk-mag">

  {featured && (
    <BlogCard
      post={featured}
      blogBase={blogBase}
      dateLocale={dateLocale}
      ctaText={t.blog.btncta}
      variant="featured"
    />
  )}

  <div class="bk-mag__right">
    {rest.map((post: BlogPost) => (
      <BlogCard
        post={post}
        blogBase={blogBase}
        dateLocale={dateLocale}
        ctaText={t.blog.btncta}
        variant="small"
      />
    ))}
  </div>

</div>

<style>
  .bk-mag {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .bk-mag {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }

  .bk-mag__right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>