---
import type { BlogPostProps } from "../types";
import { getFeaturedImageUrl } from "../utils/slug";

interface Props extends BlogPostProps {}

const { post, t } = Astro.props;

const imgUrl = getFeaturedImageUrl(post);
---

<main class="bk-post">

  <div class="bk-post__hero">
    <div class="bk-post__hero-inner">
      <span class="bk-post__tag">Technical Article</span>
      <h1 class="bk-post__title" set:html={post.title.rendered} />
      <p class="bk-post__date">
        {new Date(post.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </p>
    </div>
  </div>

  {imgUrl && (
    <div class="bk-post__image-wrap">
      <img
        src={imgUrl}
        alt={post.title.rendered}
        class="bk-post__image"
      />
    </div>
  )}

  <div class="bk-post__body">

    <aside class="bk-post__sidebar">
      <div class="bk-sidebar__block">
        <p class="bk-sidebar__label">Published</p>
        <p class="bk-sidebar__value">
          {new Date(post.date).toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          })}
        </p>
      </div>

      <div class="bk-sidebar__block">
        <p class="bk-sidebar__label">Category</p>
        <p class="bk-sidebar__value">
          {post._embedded?.["wp:term"]?.[0]?.[0]?.name ?? "General"}
        </p>
      </div>

      {post.readingTime && (
        <div class="bk-sidebar__block">
          <p class="bk-sidebar__label">Reading time</p>
          <p class="bk-sidebar__value">~{post.readingTime} min</p>
        </div>
      )}

      <div class="bk-sidebar__divider" />

      <a href="../" class="bk-sidebar__back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.5 2.5L4 7L8.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {t.blog.btn_prev ?? "Back to blog"}
      </a>
    </aside>

    <article class="bk-post__content" set:html={post.content.rendered} />

  </div>

</main>

<style>
  .bk-post {
    background-color: var(--bk-bg);
    font-family: var(--bk-font-body);
    min-height: 100vh;
    padding-bottom: 6rem;
  }

  .bk-post__hero {
    border-bottom: 1px solid var(--bk-border);
    padding: 5rem 2rem 3rem;
  }

  .bk-post__hero-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .bk-post__tag {
    display: inline-block;
    font-family: var(--bk-font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bk-accent);
    border: 1px solid var(--bk-accent);
    border-radius: 4px;
    padding: 0.2rem 0.65rem;
    margin-bottom: 1.5rem;
  }

  .bk-post__title {
    font-family: var(--bk-font-display);
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 700;
    color: var(--bk-color-text);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
    max-width: 820px;
  }

  .bk-post__date {
    font-family: var(--bk-font-mono);
    font-size: 0.8rem;
    color: var(--bk-muted);
    margin: 0;
  }

  .bk-post__image-wrap {
    max-width: 1100px;
    margin: 2.5rem auto;
    padding: 0 2rem;
  }

  .bk-post__image {
    width: 100%;
    height: min(55vw, 500px);
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--bk-border);
    display: block;
  }

  .bk-post__body {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .bk-sidebar {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bk-sidebar__block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bk-sidebar__label {
    font-family: var(--bk-font-mono);
    font-size: 0.68rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--bk-muted);
    margin: 0;
  }

  .bk-sidebar__value {
    font-family: var(--bk-font-body);
    font-size: 0.875rem;
    color: var(--bk-muted-light);
    margin: 0;
  }

  .bk-sidebar__divider {
    height: 1px;
    background: var(--bk-border);
    margin: 0.5rem 0;
  }

  .bk-sidebar__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--bk-font-mono);
    font-size: 0.75rem;
    color: var(--bk-muted);
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: color 0.15s;
  }

  .bk-sidebar__back:hover {
    color: var(--bk-accent);
  }

  .bk-post__content {
    color: var(--bk-muted-light);
    line-height: 1.85;
    font-size: 1rem;
    font-family: var(--bk-font-body);
    min-width: 0;
  }

  .bk-post__content :global(h2),
  .bk-post__content :global(h3),
  .bk-post__content :global(h4) {
    font-family: var(--bk-font-display);
    color: var(--bk-text);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 2.5rem 0 0.9rem;
    line-height: 1.15;
  }

  .bk-post__content :global(h2) { font-size: 1.75rem; }
  .bk-post__content :global(h3) { font-size: 1.35rem; }
  .bk-post__content :global(h4) { font-size: 1.1rem; }

  .bk-post__content :global(p) { margin: 0 0 1.25rem; }

  .bk-post__content :global(strong) {
    color: var(--bk-text);
    font-weight: 600;
  }

  .bk-post__content :global(a) {
    color: var(--bk-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .bk-post__content :global(ul),
  .bk-post__content :global(ol) {
    padding-left: 1.4rem;
    margin: 0 0 1.4rem;
  }

  .bk-post__content :global(li) { margin-bottom: 0.5rem; }

  .bk-post__content :global(img) {
    display: block;
    width: 100%;
    border-radius: 10px;
    margin: 2rem 0;
    border: 1px solid var(--bk-border);
  }

  .bk-post__content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 3px solid var(--bk-accent);
    background: var(--bk-surface);
    color: var(--bk-text);
    border-radius: 0 8px 8px 0;
    font-style: italic;
  }

  .bk-post__content :global(pre) {
    background: var(--bk-surface);
    border: 1px solid var(--bk-border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.75rem 0;
  }

  .bk-post__content :global(code) {
    font-family: var(--bk-font-mono);
    font-size: 0.875rem;
    color: var(--bk-accent);
    background: rgba(56, 189, 248, 0.08);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .bk-post__content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--bk-muted-light);
  }

  .bk-post__content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9rem;
  }

  .bk-post__content :global(th) {
    background: var(--bk-surface);
    color: var(--bk-text);
    border: 1px solid var(--bk-border);
    padding: 0.75rem 1rem;
    text-align: left;
    font-family: var(--bk-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .bk-post__content :global(td) {
    border: 1px solid var(--bk-border);
    padding: 0.75rem 1rem;
    color: var(--bk-muted-light);
  }

  @media (max-width: 768px) {
    .bk-post__hero { padding: 4.5rem 1.25rem 2.5rem; }

    .bk-post__image-wrap {
      padding: 0 1.25rem;
      margin: 2rem auto;
    }

    .bk-post__image { height: 240px; }

    .bk-post__body {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 0 1.25rem;
    }

    .bk-post__sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--bk-border);
    }

    .bk-sidebar__divider,
    .bk-sidebar__back { display: none; }
  }
</style>