{
  "name": "astro-blog-kit",
  "version": "0.2.7",
  "description": "A ready-to-use blog system for Astro with WordPress headless support, optional i18n, multiple layouts, and a comment system.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "astro-blog-kit": "bin/cli.js"
  },
  "scripts": {
    "build:cli": "esbuild cli.ts --bundle --platform=node --format=esm --outfile=bin/cli.js --external:@clack/prompts",
    "prepublishOnly": "npm run build:cli"
  },
  "exports": {
    ".": "./index.ts",
    "./integration": "./integration.ts",
    "./components": "./components/index.ts",
    "./utils": "./utils/index.ts"
  },
  "files": [
    "index.ts",
    "integration.ts",
    "types.ts",
    "virtual.d.ts",
    "bin",
    "cli.ts",
    "define-config.ts",
    "templates",
    "components",
    "utils"
  ],
  "keywords": [
    "astro",
    "blog",
    "wordpress",
    "i18n",
    "astro-integration",
    "astro-component",
    "headless-cms"
  ],
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@clack/prompts": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "astro": "^6.3.1",
    "esbuild": "^0.28.0",
    "tsx": "latest"
  }
}