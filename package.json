{
  "name": "astro-blog-kit",
  "version": "0.1.0",
  "description": "A ready-to-use blog system for Astro with optional i18n and multiple layouts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "astro-blog-kit": "./cli.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./integration": "./integration.ts",
    "./components": "./components/index.ts",
    "./utils": "./utils/index.ts"
  },
  "files": [
    "index.ts",
    "integration.ts",
    "types.ts",
    "virtual.d.ts",
    "cli.ts",
    "define-config.ts",
    "templates",
    "components",
    "utils"
  ],
  "keywords": [
    "astro",
    "blog",
    "i18n",
    "astro-integration",
    "astro-component"
  ],
  "devDependencies": {
    "@clack/prompts": "latest",
    "@types/node": "^25.6.2",
    "astro": "^4.0.0 || ^5.0.0"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0"
  }
}
